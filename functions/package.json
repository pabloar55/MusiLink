{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:artist-keys": "node scripts/backfill-artist-identity-keys.cjs",
    "test:artist-keys": "node --test scripts/backfill-artist-identity-keys.test.cjs",
    "migrate:recommendation-snapshots": "node scripts/backfill-recommendation-snapshots.cjs",
    "migrate:usernames": "node scripts/backfill-username-reservations.cjs",
    "test:usernames-migration": "node --test scripts/backfill-username-reservations.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "private": true
}
