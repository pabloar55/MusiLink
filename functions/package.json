{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:account-deletion": "npm run build && node --test test/account_deletion.test.cjs",
    "test:recommendation-index-migration": "node --test test/recommendation_index_migration.test.cjs",
    "test:unit": "npm run build && node --test test/unit/*.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "private": true
}
